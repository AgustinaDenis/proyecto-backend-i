
<h1>Your cart</h1>
{{#each cartProducts}}

<div class="card mb-3" style="max-width: 540px;">
  <div class="row g-0">
    <div class="col-md-4">
      <img src="{{this.product_id.img}}" class="img-fluid rounded-start" alt="..."> 
    </div>
    <div class="col-md-8">
      <div class="card-body">
        <h5 class="card-title">{{this.product_id.title}}</h5>
        <p class="card-text">Quantity: {{this.quantity}}</p>
        <p class="card-text">Price: ${{this.product_id.price}}</p>
         <input type="number" name="quantity" value="{{oneProduct.quantity}}" min="1" required>
        <button type="button" class="btn btn-dark"><i class='bx bx-trash'></i></button>
      </div>
    </div>
  </div>
</div>

{{/each}}

<button type="button" class="btn btn-dark btn-lg mb-5 me-5">BUY</i></button>
<button type="button" class="btn btn-outline-dark btn-lg mb-5 ms-5">Cancel purchase</button>
<button type="button" class="btn btn-outline-dark btn-lg mb-5"><i class='bx bx-trash'></i></button>