
<div class="card mb-3" style="max-width: 540px;">
  <div class="row g-0">
    <div class="col-md-4">
      <img src="../../public/assets/user.png" class="img-fluid rounded-start" alt="...">
    </div>
    <div class="col-md-8">
      <div class="card-body">
       <h5 class="card-title">{{#if profile.name}}{{profile.name}}{{else}}Nombre no disponible{{/if}}</h5>
      <p class="card-text">{{#if this.email}}{{this.email}}{{else}}Correo no disponible{{/if}}</p>
      </div>
    </div>
  </div>
</div>